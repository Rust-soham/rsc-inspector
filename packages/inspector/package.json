{
  "name": "next-rsc-inspector",
  "version": "0.1.2",
  "description": "Development overlay for visualizing React Server and Client Component boundaries in Next.js App Router applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rust-soham/rsc-inspector.git"
  },
  "homepage": "https://github.com/Rust-soham/rsc-inspector#readme",
  "bugs": {
    "url": "https://github.com/Rust-soham/rsc-inspector/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    }
  },
  "sideEffects": [
    "./dist/client.js"
  ],
  "keywords": [
    "nextjs",
    "react-server-components",
    "rsc",
    "developer-tools",
    "inspector"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "peerDependencies": {
    "next": ">=16.3.0 <17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check && pnpm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "effect": "4.0.0-beta.107",
    "react-devtools-inline": "7.0.1"
  }
}
